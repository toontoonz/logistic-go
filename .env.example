# Used by docker compose. Safe local defaults — do not point this at a shared network.
POSTGRES_USER=logistic
POSTGRES_PASSWORD=logistic
POSTGRES_DB=logistic
DATABASE_URL=postgres://logistic:logistic@localhost:5432/logistic?sslmode=disable
REDIS_URL=redis://localhost:6379/0
HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/positions
