# Copy to .env only if you want to override the defaults below.
# `docker compose up` does not need this file. The API container talks to
# Postgres and Redis by the names `db` and `redis` on the compose network.
# Those two services are not published on the host, so they will not fight
# with another Postgres on 5432 or another Redis on 6379.

# The web app is on host port 3000 and the API on 8080. Those two are the
# only ports a normal `docker compose up` publishes. Edit docker-compose.yml
# if either is already taken.

# Optional. Used only with docker-compose.ports.yml, when you want the
# host (go run, psql, redis-cli) to reach the Compose database.
# Defaults inside that file are 5433 and 6380.
# DB_HOST_PORT=5433
# REDIS_HOST_PORT=6380

# For `go run ./cmd/server` on the host, after starting db and redis with
# docker-compose.ports.yml. Do not point the API *container* at localhost.
DATABASE_URL=postgres://logistic:logistic@127.0.0.1:5433/logistic?sslmode=disable
REDIS_URL=redis://127.0.0.1:6380/0

HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/positions
